# HTML has no rule: Cloudflare Pages' default (max-age=0, must-revalidate)
# already checks for a fresh copy on every visit. Matching rules are joined,
# so keep these patterns from overlapping.

/*.pdf
  Cache-Control: public, max-age=3600

/*.jpg
  Cache-Control: public, max-age=86400

/*.JPG
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

/*.css
  Cache-Control: public, max-age=86400

/*.js
  Cache-Control: public, max-age=86400

/pre_2018/font/*
  Cache-Control: public, max-age=604800
